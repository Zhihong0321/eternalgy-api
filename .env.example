# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (Railway Private Networking)
# In Railway: use ${{Postgres.DATABASE_URL}} or ${{Postgres.PRIVATE_DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/prod_main
DB_SSL=false
DB_MAX_CONNECTIONS=20

# Admin Access
ADMIN_API_KEY=eter_admin_secret_key_change_in_production

# Gateway Guardrails
DEFAULT_RATE_LIMIT_RPM=120
MAX_QUERY_LIMIT=100
QUERY_TIMEOUT_MS=5000
